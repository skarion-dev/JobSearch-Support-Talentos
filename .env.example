# OpenCode Go (https://opencode.ai/zen/go) — OpenAI-compatible endpoint.
# This is the REAL upstream secret. Once the gateway is in use, only the
# gateway process (and this file, on the machine running it) needs it — the
# app and Talentos get a gateway-issued token instead (see GATEWAY_* below).
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_SCRAPER_MODEL=deepseek-v4-flash
OPENCODE_CEO_MODEL=deepseek-v4-pro
# Additional OpenCode Go keys for the gateway's rotation pool. Optional —
# add as many as you have; the gateway falls over to the next one on 429.
# OPENCODE_KEY_1=
# OPENCODE_KEY_2=

# --- LLM gateway (gateway/) ------------------------------------------------
# Leave both blank to have this app call OpenCode directly (old behaviour).
# Set both once the gateway is running to route this app's own agents
# through it instead — issue this app's token with:
#   python -m scripts.gateway_issue_key --name jobsearch-app
GATEWAY_URL=
GATEWAY_KEY=
# Only needed on the machine that RUNS the gateway process itself:
# GATEWAY_ADMIN_TOKEN=
# GATEWAY_PORT=8787

# Local SQLite DB (file-based, no server needed)
LOCAL_DB_PATH=data/jobsearch.db

# Source: Talentos Neon DB (used once for export, keep secret, rotate after sharing in plaintext)
NEON_DB_URL=

# Adzuna (developer.adzuna.com) — free tier, used for bulk US job aggregation
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional fallback account, used when the primary hits its daily quota
ADZUNA_APP_ID_2=
ADZUNA_APP_KEY_2=
